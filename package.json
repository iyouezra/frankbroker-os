{
  "name": "frankbroker-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "prisma generate && prisma migrate deploy && prisma db seed && next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "test": "npm run build && tsx --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern app/generated",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:backfill-identity": "tsx prisma/backfill-client-identity.ts",
    "db:backfill-gl-opening": "tsx prisma/backfill-gl-opening-balances.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "fflate": "^0.8.2",
    "next": "16.2.6",
    "pg": "^8.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.0.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.0.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
