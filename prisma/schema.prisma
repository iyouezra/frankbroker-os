generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Broker {
  id                     String                           @id
  name                   String
  licenseNumber          String                           @unique @map("license_number")
  status                 String                           @default("active")
  baseCurrency           String                           @default("ETB") @map("base_currency")
  createdAt              DateTime                         @default(now()) @map("created_at")
  updatedAt              DateTime                         @updatedAt @map("updated_at")
  users                  User[]
  clients                Client[]
  orders                 Order[]
  reconciliationBatches  ReconciliationBatch[]
  auditLogs              AuditLog[]
  settings               BrokerSettings?
  instrumentAccess       BrokerInstrument[]
  integrations           TenantIntegration[]
  legalDocuments         LegalDocument[]
  feeSchedules           FeeSchedule[]
  serviceRequests        ClientServiceRequest[]
  pooledBankAccounts     PooledBankAccount[]
  cashMovements          CashMovement[]
  verificationChallenges VerificationChallenge[]
  clientDocuments        ClientDocument[]
  linkedBankAccounts     LinkedBankAccount[]
  communicationThreads   CommunicationThread[]
  crmTasks               CrmTask[]
  serviceCases           ServiceCase[]
  investorAssignments    InvestorAssignment[]
  complianceReports      ComplianceReport[]
  complianceEscalations  ComplianceEscalation[]
  clientScreenings       ClientScreening[]
  tenantProfile          TenantProfile?
  tenantLicenses         TenantLicense[]
  tenantEntitlements     TenantEntitlement[]
  tenantModules          TenantModule[]
  tenantChecklistPacks   TenantChecklistPack[]
  issuers                Issuer[]
  advisoryDeals          AdvisoryDeal[]
  dealDocuments          DealDocument[]
  dealTasks              DealTask[]
  dealSubmissions        DealSubmission[]
  beneficialOwnerRecords BeneficialOwner[]
  monitoringRules        MonitoringRuleVersion[]
  monitoringAlerts       MonitoringAlert[]
  monitoringCases        MonitoringCase[]
  monitoringEvidence     MonitoringEvidence[]
  employeeProfiles       EmployeeConductProfile[]
  tradeClearances        PersonalTradeClearance[]
  restrictedSecurities   RestrictedSecurity[]
  sensitiveInfoAccess    SensitiveInformationAccess[]
  employeeDisclosures    EmployeeDisclosure[]
  conductAttestations    ConductAttestation[]
  withdrawalExceptions   WithdrawalDestinationException[]
  monitoringAuditEvents  MonitoringAuditEvent[]
  ledgerAccounts         LedgerAccount[]
  journalEntries         JournalEntry[]
  journalLines           JournalLine[]
  businessDayControls    BusinessDayControl[]
  paymentProviderEvents  PaymentProviderEvent[]
  accountingPolicies     AccountingPolicyVersion[]
  clientTradingMandates  ClientTradingMandate[]
  corporateActions       CorporateAction[]
  taxPolicies            TaxPolicyVersion[]

  @@map("brokers")
}

model User {
  id                            String                    @id
  brokerId                      String?                   @map("broker_id")
  employeeId                    String?                   @map("employee_id")
  email                         String                    @unique
  fullName                      String                    @map("full_name")
  jobTitle                      String?                   @map("job_title")
  department                    String?
  role                          String
  status                        String                    @default("active")
  lastLoginAt                   DateTime?                 @map("last_login_at")
  mfaEnabled                    Boolean                   @default(false) @map("mfa_enabled")
  authProvider                  String                    @default("pending") @map("auth_provider")
  authProviderId                String?                   @map("auth_provider_id")
  invitedAt                     DateTime?                 @map("invited_at")
  invitationExpiresAt           DateTime?                 @map("invitation_expires_at")
  passwordResetRequired         Boolean                   @default(false) @map("password_reset_required")
  passwordResetRequestedAt      DateTime?                 @map("password_reset_requested_at")
  accessReviewDueAt             DateTime?                 @map("access_review_due_at")
  deactivatedAt                 DateTime?                 @map("deactivated_at")
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  broker                        Broker?                   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  assignedOrders                Order[]                   @relation("AssignedTrader")
  approvedOrders                Order[]                   @relation("OrderApprover")
  capturedTrades                Trade[]                   @relation("TradeCapturer")
  confirmedSettlements          Settlement[]              @relation("SettlementConfirmer")
  cashLedgerEntries             CashLedgerEntry[]         @relation("CashLedgerCreator")
  securitiesLedgerEntries       SecuritiesLedgerEntry[]   @relation("SecuritiesLedgerCreator")
  uploadedReconciliationBatches ReconciliationBatch[]     @relation("BatchUploader")
  resolvedExceptions            ReconciliationException[] @relation("ExceptionResolver")
  auditLogs                     AuditLog[]                @relation("AuditActor")
  orderEvents                   OrderEvent[]              @relation("OrderEventActor")
  clientNotes                   ClientNote[]              @relation("ClientNoteAuthor")
  createdClients                Client[]                  @relation("ClientCreator")
  approvedClients               Client[]                  @relation("ClientApprover")
  submittedCashMovements        CashMovement[]            @relation("CashMovementSubmitter")
  reviewedCashMovements         CashMovement[]            @relation("CashMovementReviewer")
  completedCashMovements        CashMovement[]            @relation("CashMovementCompleter")
  clientMoneyLedgerEntries      ClientMoneyLedgerEntry[]  @relation("ClientMoneyLedgerCreator")
  pooledBankLedgerEntries       PooledBankLedgerEntry[]   @relation("PooledBankLedgerCreator")
  reviewedClientDocuments       ClientDocument[]          @relation("ClientDocumentReviewer")
  reviewedLinkedBankAccounts    LinkedBankAccount[]       @relation("LinkedBankReviewer")
  assignedThreads               CommunicationThread[]     @relation("ThreadAssignee")
  authoredMessages              CommunicationMessage[]    @relation("MessageAuthor")
  assignedTasks                 CrmTask[]                 @relation("TaskAssignee")
  createdTasks                  CrmTask[]                 @relation("TaskCreator")
  completedTasks                CrmTask[]                 @relation("TaskCompleter")
  ownedCases                    ServiceCase[]             @relation("CaseOwner")
  primaryAssignments            InvestorAssignment[]      @relation("AssignmentPrimary")
  backupAssignments             InvestorAssignment[]      @relation("AssignmentBackup")
  recordedAssignments           InvestorAssignment[]      @relation("AssignmentRecorder")
  preparedComplianceReports     ComplianceReport[]        @relation("ComplianceReportPreparer")
  reviewedComplianceReports     ComplianceReport[]        @relation("ComplianceReportReviewer")
  submittedComplianceReports    ComplianceReport[]        @relation("ComplianceReportSubmitter")
  createdComplianceEscalations  ComplianceEscalation[]    @relation("ComplianceEscalationCreator")
  reviewedComplianceEscalations ComplianceEscalation[]    @relation("ComplianceEscalationReviewer")
  recordedClientScreenings      ClientScreening[]         @relation("ClientScreeningRecorder")
  signedReconciliationBatches   ReconciliationBatch[]     @relation("ReconciliationReviewer")
  closedBusinessDays            BusinessDayControl[]      @relation("BusinessDayCloser")
  reopenedBusinessDays          BusinessDayControl[]      @relation("BusinessDayReopener")
  employeeConductProfile        EmployeeConductProfile?
  postedJournalEntries          JournalEntry[]            @relation("JournalPoster")
  approvedJournalEntries        JournalEntry[]            @relation("JournalApprover")
  approvedAccountingPolicies    AccountingPolicyVersion[] @relation("AccountingPolicyApprover")

  @@unique([brokerId, employeeId])
  @@index([brokerId, status])
  @@map("users")
}

model Client {
  id                           String                   @id
  brokerId                     String                   @map("broker_id")
  clientCode                   String                   @unique @map("client_code")
  fullName                     String                   @map("full_name")
  clientType                   String                   @default("individual") @map("client_type")
  phone                        String?
  email                        String?
  taxId                        String?                  @map("tax_id")
  taxIdentityReference         String?                  @map("tax_identity_reference")
  identityReference            String?                  @map("identity_reference")
  faydaLast7                   String?                  @map("fayda_last7")
  taxIdLast4                   String?                  @map("tax_id_last4")
  kycConsentAt                 DateTime?                @map("kyc_consent_at")
  address                      String?
  proofOfAddressType           String?                  @map("proof_of_address_type")
  proofOfAddressReference      String?                  @map("proof_of_address_reference")
  proofOfAddressStatus         String                   @default("pending") @map("proof_of_address_status")
  businessRegistrationNumber   String?                  @map("business_registration_number")
  authorizedRepresentativeName String?                  @map("authorized_representative_name")
  signatoryAuthorityConfirmed  Boolean                  @default(false) @map("signatory_authority_confirmed")
  beneficialOwners             Json?                    @map("beneficial_owners")
  kycReviewDueAt               DateTime?                @map("kyc_review_due_at")
  electronicDeliveryConsentAt  DateTime?                @map("electronic_delivery_consent_at")
  kycStatus                    String                   @default("pending") @map("kyc_status")
  riskRating                   String                   @default("standard") @map("risk_rating")
  status                       String                   @default("active")
  createdBy                    String?                  @map("created_by")
  submittedAt                  DateTime?                @map("submitted_at")
  approvedBy                   String?                  @map("approved_by")
  approvedAt                   DateTime?                @map("approved_at")
  rejectionReason              String?                  @map("rejection_reason")
  onboardingChannel            String                   @default("in_person") @map("onboarding_channel")
  externalClientReference      String?                  @map("external_client_reference")
  portalAuthSubject            String?                  @map("portal_auth_subject")
  dateOfBirth                  DateTime?                @map("date_of_birth") @db.Date
  nationality                  String?
  countryOfResidence           String?                  @map("country_of_residence")
  occupation                   String?
  employerName                 String?                  @map("employer_name")
  sourceOfFunds                String?                  @map("source_of_funds")
  investmentObjective          String?                  @map("investment_objective")
  taxResidency                 String?                  @map("tax_residency")
  pepStatus                    String                   @default("not_declared") @map("pep_status")
  bankName                     String?                  @map("bank_name")
  bankAccountName              String?                  @map("bank_account_name")
  bankAccountLast4             String?                  @map("bank_account_last4")
  phoneVerifiedAt              DateTime?                @map("phone_verified_at")
  identityVerifiedAt           DateTime?                @map("identity_verified_at")
  createdAt                    DateTime                 @default(now()) @map("created_at")
  updatedAt                    DateTime                 @updatedAt @map("updated_at")
  broker                       Broker                   @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  accounts                     Account[]
  consents                     ClientConsent[]
  serviceRequests              ClientServiceRequest[]
  notes                        ClientNote[]
  creator                      User?                    @relation("ClientCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  approver                     User?                    @relation("ClientApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  cashMovements                CashMovement[]
  verificationChallenges       VerificationChallenge[]
  documents                    ClientDocument[]
  linkedBankAccounts           LinkedBankAccount[]
  communicationThreads         CommunicationThread[]
  crmTasks                     CrmTask[]
  serviceCases                 ServiceCase[]
  investorAssignments          InvestorAssignment[]
  complianceReports            ComplianceReport[]
  screenings                   ClientScreening[]
  beneficialOwnerRecords       BeneficialOwner[]
  monitoringAlerts             MonitoringAlert[]
  employeeConductProfiles      EmployeeConductProfile[]
  tradingMandate               ClientTradingMandate?

  @@unique([brokerId, identityReference])
  @@unique([brokerId, portalAuthSubject])
  @@index([brokerId])
  @@index([status, kycStatus])
  @@map("clients")
}

model ClientDocument {
  id              String                 @id
  brokerId        String                 @map("broker_id")
  clientId        String                 @map("client_id")
  documentType    String                 @map("document_type")
  originalName    String                 @map("original_name")
  mimeType        String                 @map("mime_type")
  sizeBytes       Int                    @map("size_bytes")
  source          String
  status          String                 @default("pending_review")
  reviewedBy      String?                @map("reviewed_by")
  reviewedAt      DateTime?              @map("reviewed_at")
  rejectionReason String?                @map("rejection_reason")
  uploadedAt      DateTime               @default(now()) @map("uploaded_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  broker          Broker                 @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client          Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewer        User?                  @relation("ClientDocumentReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  content         ClientDocumentContent?

  @@unique([clientId, documentType])
  @@index([brokerId, status, uploadedAt])
  @@map("client_documents")
}

model ClientDocumentContent {
  documentId String         @id @map("document_id")
  bytes      Bytes
  document   ClientDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("client_document_contents")
}

model LinkedBankAccount {
  id                       String         @id
  brokerId                 String         @map("broker_id")
  clientId                 String         @map("client_id")
  bankName                 String         @map("bank_name")
  accountNumber            String         @map("account_number")
  accountHolderName        String         @map("account_holder_name")
  source                   String
  status                   String         @default("pending_review")
  reviewedBy               String?        @map("reviewed_by")
  reviewedAt               DateTime?      @map("reviewed_at")
  rejectionReason          String?        @map("rejection_reason")
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  broker                   Broker         @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client                   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewer                 User?          @relation("LinkedBankReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  destinationCashMovements CashMovement[] @relation("CashDestinationBank")
  sourceCashMovements      CashMovement[] @relation("CashSourceBank")

  @@unique([clientId, bankName, accountNumber])
  @@index([brokerId, status, createdAt])
  @@map("linked_bank_accounts")
}

model Account {
  id                       String                   @id
  clientId                 String                   @map("client_id")
  accountNumber            String                   @unique @map("account_number")
  accountType              String                   @default("cash") @map("account_type")
  csdReference             String?                  @map("csd_reference")
  currency                 String                   @default("ETB")
  totalCash                Decimal                  @default(0) @map("total_cash") @db.Decimal(20, 4)
  availableCash            Decimal                  @default(0) @map("available_cash") @db.Decimal(20, 4)
  blockedCash              Decimal                  @default(0) @map("blocked_cash") @db.Decimal(20, 4)
  unsettledCash            Decimal                  @default(0) @map("unsettled_cash") @db.Decimal(20, 4)
  version                  Int                      @default(0)
  status                   String                   @default("active")
  restrictionReason        String?                  @map("restriction_reason")
  restrictedAt             DateTime?                @map("restricted_at")
  closureRequestedAt       DateTime?                @map("closure_requested_at")
  closedAt                 DateTime?                @map("closed_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  client                   Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  holdings                 Holding[]
  orders                   Order[]
  cashLedgerEntries        CashLedgerEntry[]
  securitiesLedgerEntries  SecuritiesLedgerEntry[]
  serviceRequests          ClientServiceRequest[]
  clientMoneyPositions     ClientMoneyPosition[]
  clientMoneyLedgerEntries ClientMoneyLedgerEntry[]
  cashMovements            CashMovement[]
  verificationChallenges   VerificationChallenge[]
  communicationThreads     CommunicationThread[]
  employeeConductProfiles  EmployeeConductProfile[]
  journalEntries           JournalEntry[]
  journalLines             JournalLine[]
  corporateActionEntitlements CorporateActionEntitlement[]
  taxLots                  TaxLot[]

  @@index([clientId])
  @@map("accounts")
}

model Instrument {
  id                      String                       @id
  symbol                  String                       @unique
  name                    String
  assetClass              String                       @map("asset_class")
  sector                  String?
  marketSegment           String                       @default("main") @map("market_segment")
  issuer                  String
  tradingStatus           String                       @default("tradable") @map("trading_status")
  currency                String                       @default("ETB")
  lotSize                 Int                          @default(1) @map("lot_size")
  tickSize                Decimal                      @default(0.01) @map("tick_size") @db.Decimal(12, 6)
  settlementCycle         String                       @default("T+2") @map("settlement_cycle")
  faceValue               Decimal?                     @map("face_value") @db.Decimal(20, 6)
  maturityDate            DateTime?                    @map("maturity_date") @db.Date
  couponRate              Decimal?                     @map("coupon_rate") @db.Decimal(9, 6)
  couponFrequency         String?                      @map("coupon_frequency")
  lastPrice               Decimal?                     @map("last_price") @db.Decimal(20, 6)
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  holdings                Holding[]
  orders                  Order[]
  securitiesLedgerEntries SecuritiesLedgerEntry[]
  brokerAccess            BrokerInstrument[]
  tradeClearances         PersonalTradeClearance[]
  restrictedSecurities    RestrictedSecurity[]
  sensitiveInfoAccess     SensitiveInformationAccess[]
  journalLines            JournalLine[]
  corporateActions        CorporateAction[]
  taxLots                 TaxLot[]

  @@map("instruments")
}

model BrokerSettings {
  id                     String   @id
  brokerId               String   @unique @map("broker_id")
  tradingName            String   @map("trading_name")
  plan                   String   @default("Pilot")
  domain                 String?
  supportEmail           String?  @map("support_email")
  primaryColor           String   @default("#0C8189") @map("primary_color")
  welcomeMessage         String?  @map("welcome_message")
  timezone               String   @default("Africa/Addis_Ababa")
  businessDate           DateTime @map("business_date") @db.Date
  features               Json
  makerChecker           Boolean  @default(true) @map("maker_checker")
  approvalThreshold      Decimal  @default(250000) @map("approval_threshold") @db.Decimal(20, 4)
  clientDailyLimit       Decimal  @default(2500000) @map("client_daily_limit") @db.Decimal(20, 4)
  brokerageFeePct        Decimal  @default(0.5) @map("brokerage_fee_pct") @db.Decimal(8, 4)
  minimumFee             Decimal  @default(25) @map("minimum_fee") @db.Decimal(20, 4)
  settlementCycle        String   @default("T+2") @map("settlement_cycle")
  allowedOrderTypes      Json     @map("allowed_order_types")
  requireTermsAcceptance Boolean  @default(true) @map("require_terms_acceptance")
  discrepancyWindowDays  Int      @default(10) @map("discrepancy_window_days")
  kycReviewMonths        Int      @default(12) @map("kyc_review_months")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  broker                 Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@map("broker_settings")
}

/// Additive tenant vocabulary around the legacy Broker record. Existing broker
/// services keep their brokerId boundary while new cross-product modules use
/// tenantId and resolve through this profile.
model TenantProfile {
  tenantId     String   @id @map("tenant_id")
  businessType String   @map("business_type")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Broker   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_profiles")
}

model TenantLicense {
  id            String    @id
  tenantId      String    @map("tenant_id")
  regulator     String    @default("ECMA")
  licenseType   String    @map("license_type")
  licenseNumber String    @map("license_number")
  status        String    @default("active")
  validFrom     DateTime? @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  tenant        Broker    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, licenseNumber])
  @@index([tenantId, status])
  @@map("tenant_licenses")
}

model TenantEntitlement {
  id          String    @id
  tenantId    String    @map("tenant_id")
  activityKey String    @map("activity_key")
  basis       String?
  status      String    @default("active")
  validFrom   DateTime? @map("valid_from") @db.Date
  validTo     DateTime? @map("valid_to") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenant      Broker    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, activityKey])
  @@index([tenantId, status])
  @@map("tenant_entitlements")
}

model TenantModule {
  id        String   @id
  tenantId  String   @map("tenant_id")
  moduleKey String   @map("module_key")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Broker   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId, enabled])
  @@map("tenant_modules")
}

model ChecklistTemplate {
  id              String                  @id
  code            String
  version         String
  transactionType String                  @map("transaction_type")
  marketSegment   String                  @map("market_segment")
  title           String
  status          String                  @default("draft")
  effectiveFrom   DateTime                @map("effective_from") @db.Date
  sourceSet       Json                    @map("source_set")
  createdAt       DateTime                @default(now()) @map("created_at")
  items           ChecklistTemplateItem[]
  tenantPacks     TenantChecklistPack[]
  deals           AdvisoryDeal[]

  @@unique([code, version, marketSegment])
  @@index([transactionType, marketSegment, status])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id               String              @id
  templateId       String              @map("template_id")
  itemCode         String              @map("item_code")
  section          String
  title            String
  guidance         String
  expectedEvidence String              @map("expected_evidence")
  required         Boolean             @default(true)
  sortOrder        Int                 @map("sort_order")
  sourceTitle      String              @map("source_title")
  sourceUrl        String              @map("source_url")
  sourceReference  String              @map("source_reference")
  template         ChecklistTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dealItems        DealChecklistItem[]

  @@unique([templateId, itemCode])
  @@index([templateId, sortOrder])
  @@map("checklist_template_items")
}

model TenantChecklistPack {
  id         String            @id
  tenantId   String            @map("tenant_id")
  templateId String            @map("template_id")
  enabled    Boolean           @default(true)
  createdAt  DateTime          @default(now()) @map("created_at")
  tenant     Broker            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([tenantId, templateId])
  @@index([tenantId, enabled])
  @@map("tenant_checklist_packs")
}

model Issuer {
  id                 String         @id
  tenantId           String         @map("tenant_id")
  legalName          String         @map("legal_name")
  tradingName        String?        @map("trading_name")
  entityType         String         @map("entity_type")
  registrationNumber String?        @map("registration_number")
  tinReference       String?        @map("tin_reference")
  sector             String?
  contactName        String?        @map("contact_name")
  contactEmail       String?        @map("contact_email")
  contactPhone       String?        @map("contact_phone")
  status             String         @default("active")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  tenant             Broker         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  deals              AdvisoryDeal[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId, status, legalName])
  @@map("issuers")
}

model AdvisoryDeal {
  id                  String              @id
  tenantId            String              @map("tenant_id")
  issuerId            String              @map("issuer_id")
  checklistTemplateId String              @map("checklist_template_id")
  name                String
  transactionType     String              @map("transaction_type")
  marketSegment       String              @map("market_segment")
  mandateReference    String?             @map("mandate_reference")
  leadUserId          String?             @map("lead_user_id")
  stage               String              @default("draft")
  status              String              @default("active")
  targetDate          DateTime?           @map("target_date") @db.Date
  stageOverrideReason String?             @map("stage_override_reason")
  createdByUserId     String?             @map("created_by_user_id")
  version             Int                 @default(0)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  tenant              Broker              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  issuer              Issuer              @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  checklistTemplate   ChecklistTemplate   @relation(fields: [checklistTemplateId], references: [id], onDelete: Restrict)
  parties             DealParty[]
  checklistItems      DealChecklistItem[]
  documents           DealDocument[]
  tasks               DealTask[]
  submissions         DealSubmission[]

  @@unique([tenantId, mandateReference])
  @@index([tenantId, stage, status])
  @@index([tenantId, issuerId])
  @@map("advisory_deals")
}

model DealParty {
  id           String       @id
  tenantId     String       @map("tenant_id")
  dealId       String       @map("deal_id")
  partyRole    String       @map("party_role")
  organization String
  contactName  String?      @map("contact_name")
  email        String?
  phone        String?
  status       String       @default("active")
  createdAt    DateTime     @default(now()) @map("created_at")
  deal         AdvisoryDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId, dealId, partyRole])
