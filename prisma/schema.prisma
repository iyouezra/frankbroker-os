  source            String                    @default("manual_upload")
  feedType          String                    @default("esx_executions") @map("feed_type")
  contentHash       String?                   @map("content_hash")
  inputRows         Json?                     @map("input_rows")
  controlTotals     Json?                     @map("control_totals")
  attemptNumber     Int                       @default(1) @map("attempt_number")
  supersedesBatchId String?                   @unique @map("supersedes_batch_id")
  totalRecords      Int                       @default(0) @map("total_records")
  matchedRecords    Int                       @default(0) @map("matched_records")
  exceptionRecords  Int                       @default(0) @map("exception_records")
  status            String                    @default("processing")
  uploadedBy        String                    @map("uploaded_by")
  reviewedBy        String?                   @map("reviewed_by")
