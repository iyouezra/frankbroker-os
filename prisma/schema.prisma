generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Broker {
  id                    String                 @id
  name                  String
  licenseNumber         String                 @unique @map("license_number")
  status                String                 @default("active")
  baseCurrency          String                 @default("ETB") @map("base_currency")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  users                 User[]
  clients               Client[]
  orders                Order[]
  reconciliationBatches ReconciliationBatch[]
  auditLogs             AuditLog[]
  settings              BrokerSettings?
  instrumentAccess      BrokerInstrument[]
  integrations          TenantIntegration[]
  legalDocuments        LegalDocument[]
  feeSchedules          FeeSchedule[]
  serviceRequests       ClientServiceRequest[]
  pooledBankAccounts    PooledBankAccount[]
  cashMovements         CashMovement[]
  verificationChallenges VerificationChallenge[]

  @@map("brokers")
}

model User {
  id                            String                    @id
  brokerId                      String?                   @map("broker_id")
  email                         String                    @unique
  fullName                      String                    @map("full_name")
  role                          String
  status                        String                    @default("active")
  lastLoginAt                   DateTime?                 @map("last_login_at")
  mfaEnabled                    Boolean                   @default(false) @map("mfa_enabled")
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  broker                        Broker?                   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  assignedOrders                Order[]                   @relation("AssignedTrader")
  approvedOrders                Order[]                   @relation("OrderApprover")
  capturedTrades                Trade[]                   @relation("TradeCapturer")
  confirmedSettlements          Settlement[]              @relation("SettlementConfirmer")
  cashLedgerEntries             CashLedgerEntry[]         @relation("CashLedgerCreator")
  securitiesLedgerEntries       SecuritiesLedgerEntry[]   @relation("SecuritiesLedgerCreator")
  uploadedReconciliationBatches ReconciliationBatch[]     @relation("BatchUploader")
  resolvedExceptions            ReconciliationException[] @relation("ExceptionResolver")
  auditLogs                     AuditLog[]                @relation("AuditActor")
  orderEvents                   OrderEvent[]              @relation("OrderEventActor")
  clientNotes                   ClientNote[]              @relation("ClientNoteAuthor")
  createdClients                Client[]                  @relation("ClientCreator")
  approvedClients               Client[]                  @relation("ClientApprover")
  submittedCashMovements        CashMovement[]            @relation("CashMovementSubmitter")
  reviewedCashMovements         CashMovement[]            @relation("CashMovementReviewer")
  completedCashMovements        CashMovement[]            @relation("CashMovementCompleter")
  clientMoneyLedgerEntries      ClientMoneyLedgerEntry[]  @relation("ClientMoneyLedgerCreator")
  pooledBankLedgerEntries       PooledBankLedgerEntry[]   @relation("PooledBankLedgerCreator")

  @@index([brokerId])
  @@map("users")
}

model Client {
  id                           String                 @id
  brokerId                     String                 @map("broker_id")
  clientCode                   String                 @unique @map("client_code")
  fullName                     String                 @map("full_name")
  clientType                   String                 @default("individual") @map("client_type")
  phone                        String?
  email                        String?
  taxId                        String?                @map("tax_id")
  identityReference            String?                @map("identity_reference")
  faydaLast4                   String?                @map("fayda_last4")
  taxIdLast4                   String?                @map("tax_id_last4")
  kycConsentAt                 DateTime?              @map("kyc_consent_at")
  address                      String?
  proofOfAddressType           String?                @map("proof_of_address_type")
  proofOfAddressReference      String?                @map("proof_of_address_reference")
  proofOfAddressStatus         String                 @default("pending") @map("proof_of_address_status")
  businessRegistrationNumber   String?                @map("business_registration_number")
  authorizedRepresentativeName String?                @map("authorized_representative_name")
  signatoryAuthorityConfirmed  Boolean                @default(false) @map("signatory_authority_confirmed")
  beneficialOwners             Json?                  @map("beneficial_owners")
  kycReviewDueAt               DateTime?              @map("kyc_review_due_at")
  electronicDeliveryConsentAt  DateTime?              @map("electronic_delivery_consent_at")
  kycStatus                    String                 @default("pending") @map("kyc_status")
  riskRating                   String                 @default("standard") @map("risk_rating")
  status                       String                 @default("active")
  createdBy                    String?                @map("created_by")
  submittedAt                  DateTime?              @map("submitted_at")
  approvedBy                   String?                @map("approved_by")
  approvedAt                   DateTime?              @map("approved_at")
  rejectionReason              String?                @map("rejection_reason")
  onboardingChannel            String                 @default("in_person") @map("onboarding_channel")
  externalClientReference      String?                @map("external_client_reference")
  dateOfBirth                  DateTime?               @map("date_of_birth") @db.Date
  nationality                  String?
  countryOfResidence           String?                @map("country_of_residence")
  occupation                   String?
  employerName                 String?                @map("employer_name")
  sourceOfFunds                String?                @map("source_of_funds")
  investmentObjective          String?                @map("investment_objective")
  taxResidency                 String?                @map("tax_residency")
  pepStatus                    String                 @default("not_declared") @map("pep_status")
  bankName                     String?                @map("bank_name")
  bankAccountName              String?                @map("bank_account_name")
  bankAccountLast4             String?                @map("bank_account_last4")
  phoneVerifiedAt              DateTime?              @map("phone_verified_at")
  identityVerifiedAt           DateTime?              @map("identity_verified_at")
  createdAt                    DateTime               @default(now()) @map("created_at")
  updatedAt                    DateTime               @updatedAt @map("updated_at")
  broker                       Broker                 @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  accounts                     Account[]
  consents                     ClientConsent[]
  serviceRequests              ClientServiceRequest[]
  notes                        ClientNote[]
  creator                      User?                  @relation("ClientCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  approver                     User?                  @relation("ClientApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  cashMovements                CashMovement[]
  verificationChallenges      VerificationChallenge[]

  @@index([brokerId])
  @@index([status, kycStatus])
  @@map("clients")
}

model Account {
  id                       String                   @id
  clientId                 String                   @map("client_id")
  accountNumber            String                   @unique @map("account_number")
  accountType              String                   @default("cash") @map("account_type")
  csdReference             String?                  @map("csd_reference")
  currency                 String                   @default("ETB")
  totalCash                Decimal                  @default(0) @map("total_cash") @db.Decimal(20, 4)
  availableCash            Decimal                  @default(0) @map("available_cash") @db.Decimal(20, 4)
  blockedCash              Decimal                  @default(0) @map("blocked_cash") @db.Decimal(20, 4)
  unsettledCash            Decimal                  @default(0) @map("unsettled_cash") @db.Decimal(20, 4)
  version                  Int                      @default(0)
  status                   String                   @default("active")
  restrictionReason        String?                  @map("restriction_reason")
  restrictedAt             DateTime?                @map("restricted_at")
  closureRequestedAt       DateTime?                @map("closure_requested_at")
  closedAt                 DateTime?                @map("closed_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  client                   Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  holdings                 Holding[]
  orders                   Order[]
  cashLedgerEntries        CashLedgerEntry[]
  securitiesLedgerEntries  SecuritiesLedgerEntry[]
  serviceRequests          ClientServiceRequest[]
  clientMoneyPositions     ClientMoneyPosition[]
  clientMoneyLedgerEntries ClientMoneyLedgerEntry[]
  cashMovements            CashMovement[]
  verificationChallenges   VerificationChallenge[]

  @@index([clientId])
  @@map("accounts")
}

model Instrument {
  id                      String                  @id
  symbol                  String                  @unique
  name                    String
  assetClass              String                  @map("asset_class")
  marketSegment           String                  @default("main") @map("market_segment")
  issuer                  String
  tradingStatus           String                  @default("tradable") @map("trading_status")
  currency                String                  @default("ETB")
  lotSize                 Int                     @default(1) @map("lot_size")
  tickSize                Decimal                 @default(0.01) @map("tick_size") @db.Decimal(12, 6)
  settlementCycle         String                  @default("T+2") @map("settlement_cycle")
  faceValue               Decimal?                @map("face_value") @db.Decimal(20, 6)
  maturityDate            DateTime?               @map("maturity_date") @db.Date
  couponRate              Decimal?                @map("coupon_rate") @db.Decimal(9, 6)
  couponFrequency         String?                 @map("coupon_frequency")
  lastPrice               Decimal?                @map("last_price") @db.Decimal(20, 6)
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  holdings                Holding[]
  orders                  Order[]
  securitiesLedgerEntries SecuritiesLedgerEntry[]
  brokerAccess            BrokerInstrument[]

  @@map("instruments")
}

model BrokerSettings {
  id                     String   @id
  brokerId               String   @unique @map("broker_id")
  tradingName            String   @map("trading_name")
  plan                   String   @default("Pilot")
  domain                 String?
  supportEmail           String?  @map("support_email")
  primaryColor           String   @default("#0C8189") @map("primary_color")
  welcomeMessage         String?  @map("welcome_message")
  timezone               String   @default("Africa/Addis_Ababa")
  businessDate           DateTime @map("business_date") @db.Date
  features               Json
  makerChecker           Boolean  @default(true) @map("maker_checker")
  approvalThreshold      Decimal  @default(250000) @map("approval_threshold") @db.Decimal(20, 4)
  clientDailyLimit       Decimal  @default(2500000) @map("client_daily_limit") @db.Decimal(20, 4)
  brokerageFeePct        Decimal  @default(0.5) @map("brokerage_fee_pct") @db.Decimal(8, 4)
  minimumFee             Decimal  @default(25) @map("minimum_fee") @db.Decimal(20, 4)
  settlementCycle        String   @default("T+2") @map("settlement_cycle")
  allowedOrderTypes      Json     @map("allowed_order_types")
  requireTermsAcceptance Boolean  @default(true) @map("require_terms_acceptance")
  discrepancyWindowDays  Int      @default(10) @map("discrepancy_window_days")
  kycReviewMonths        Int      @default(12) @map("kyc_review_months")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  broker                 Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@map("broker_settings")
}

model LegalDocument {
  id                   String          @id
  brokerId             String          @map("broker_id")
  documentType         String          @default("brokerage_terms") @map("document_type")
  title                String
  version              String
  language             String          @default("en")
  summary              String
  content              String
  status               String          @default("draft")
  effectiveAt          DateTime        @map("effective_at") @db.Date
  publishedAt          DateTime?       @map("published_at")
  requiresReacceptance Boolean         @default(true) @map("requires_reacceptance")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  broker               Broker          @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  consents             ClientConsent[]

  @@unique([brokerId, documentType, version, language])
  @@index([brokerId, documentType, status])
  @@map("legal_documents")
}

model ClientConsent {
  id              String         @id
  clientId        String         @map("client_id")
  legalDocumentId String?        @map("legal_document_id")
  consentType     String         @map("consent_type")
  version         String
  accepted        Boolean        @default(true)
  channel         String         @default("investor_portal")
  acceptedAt      DateTime       @default(now()) @map("accepted_at")
  withdrawnAt     DateTime?      @map("withdrawn_at")
  metadata        Json?
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  legalDocument   LegalDocument? @relation(fields: [legalDocumentId], references: [id], onDelete: SetNull)

  @@index([clientId, consentType, acceptedAt])
  @@map("client_consents")
}

model FeeSchedule {
  id            String    @id
  brokerId      String    @map("broker_id")
  name          String
  version       String
  status        String    @default("draft")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  broker        Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  rules         FeeRule[]

  @@unique([brokerId, version])
  @@index([brokerId, status, effectiveFrom])
  @@map("fee_schedules")
}

model FeeRule {
  id            String      @id
  feeScheduleId String      @map("fee_schedule_id")
  assetClass    String      @map("asset_class")
  marketSegment String      @default("main") @map("market_segment")
  brokeragePct  Decimal     @default(0) @map("brokerage_pct") @db.Decimal(8, 4)
  regulatorPct  Decimal     @default(0) @map("regulator_pct") @db.Decimal(8, 4)
  exchangePct   Decimal     @default(0) @map("exchange_pct") @db.Decimal(8, 4)
  csdPct        Decimal     @default(0) @map("csd_pct") @db.Decimal(8, 4)
  minimumFee    Decimal     @default(0) @map("minimum_fee") @db.Decimal(20, 4)
  maximumFee    Decimal?    @map("maximum_fee") @db.Decimal(20, 4)
  schedule      FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)

  @@unique([feeScheduleId, assetClass, marketSegment])
  @@map("fee_rules")
}

model BrokerInstrument {
  id           String     @id
  brokerId     String     @map("broker_id")
  instrumentId String     @map("instrument_id")
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  broker       Broker     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([brokerId, instrumentId])
  @@index([instrumentId])
  @@map("broker_instruments")
}

model TenantIntegration {
  id          String   @id
  brokerId    String   @map("broker_id")
  key         String
  name        String
  description String
  status      String   @default("not_connected")
  mode        String   @default("manual")
  settings    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  broker      Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([brokerId, key])
  @@index([brokerId])
  @@map("tenant_integrations")
}

model Holding {
  id                String     @id
  accountId         String     @map("account_id")
  instrumentId      String     @map("instrument_id")
  totalQuantity     Decimal    @default(0) @map("total_quantity") @db.Decimal(24, 8)
  availableQuantity Decimal    @default(0) @map("available_quantity") @db.Decimal(24, 8)
  blockedQuantity   Decimal    @default(0) @map("blocked_quantity") @db.Decimal(24, 8)
  unsettledQuantity Decimal    @default(0) @map("unsettled_quantity") @db.Decimal(24, 8)
  averageCost       Decimal    @default(0) @map("average_cost") @db.Decimal(20, 6)
  version           Int        @default(0)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  account           Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument        Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@unique([accountId, instrumentId])
  @@index([instrumentId])
  @@map("holdings")
}

model Order {
  id                       String                   @id
  brokerId                 String                   @map("broker_id")
  submissionReference      String?                  @map("submission_reference")
  accountId                String                   @map("account_id")
  instrumentId             String                   @map("instrument_id")
  side                     String
  quantity                 Decimal                  @db.Decimal(24, 8)
  price                    Decimal                  @db.Decimal(20, 6)
  triggerPrice             Decimal?                 @map("trigger_price") @db.Decimal(20, 6)
  orderType                String                   @default("limit") @map("order_type")
  validity                 String                   @default("day")
  estimatedGross           Decimal                  @map("estimated_gross") @db.Decimal(20, 4)
  estimatedFees            Decimal                  @map("estimated_fees") @db.Decimal(20, 4)
  estimatedNet             Decimal                  @map("estimated_net") @db.Decimal(20, 4)
  filledQuantity           Decimal                  @default(0) @map("filled_quantity") @db.Decimal(24, 8)
  remainingQuantity        Decimal                  @default(0) @map("remaining_quantity") @db.Decimal(24, 8)
  averageFillPrice         Decimal?                 @map("average_fill_price") @db.Decimal(20, 6)
  executedGross            Decimal                  @default(0) @map("executed_gross") @db.Decimal(20, 4)
  executedFees             Decimal                  @default(0) @map("executed_fees") @db.Decimal(20, 4)
  executedNet              Decimal                  @default(0) @map("executed_net") @db.Decimal(20, 4)
  blockedCash              Decimal                  @default(0) @map("blocked_cash") @db.Decimal(20, 4)
  blockedQuantity          Decimal                  @default(0) @map("blocked_quantity") @db.Decimal(24, 8)
  status                   String                   @default("draft")
  source                   String                   @default("manual")
  instructionVerificationId String?                 @unique @map("instruction_verification_id")
  instructionVerifiedAt     DateTime?                @map("instruction_verified_at")
  assignedTraderId         String?                  @map("assigned_trader_id")
  riskFlag                 String                   @default("none") @map("risk_flag")
  notes                    String?
  rejectionReason          String?                  @map("rejection_reason")
  submittedAt              DateTime?                @map("submitted_at")
  approvedAt               DateTime?                @map("approved_at")
  approvedBy               String?                  @map("approved_by")
  contractNoteNumber       String?                  @unique @map("contract_note_number")
  contractNoteGeneratedAt  DateTime?                @map("contract_note_generated_at")
  contractNoteGeneratedBy  String?                  @map("contract_note_generated_by")
  estimatedFeeBreakdown    Json?                    @map("estimated_fee_breakdown")
  termsVersion             String?                  @map("terms_version")
  disclosureVersion        String?                  @map("disclosure_version")
  disclosureAcceptedAt     DateTime?                @map("disclosure_accepted_at")
  version                  Int                      @default(0)
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  broker                   Broker                   @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  account                  Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  instrument               Instrument               @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  assignedTrader           User?                    @relation("AssignedTrader", fields: [assignedTraderId], references: [id], onDelete: SetNull)
  approver                 User?                    @relation("OrderApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  validations              OrderValidation[]
  events                   OrderEvent[]
  trades                   Trade[]
  cashLedgerEntries        CashLedgerEntry[]
  securityLedgerEntries    SecuritiesLedgerEntry[]
  serviceRequests          ClientServiceRequest[]
  clientMoneyLedgerEntries ClientMoneyLedgerEntry[]
  pooledBankLedgerEntries  PooledBankLedgerEntry[]
  instructionVerification VerificationChallenge?    @relation(fields: [instructionVerificationId], references: [id], onDelete: Restrict)

  @@unique([brokerId, submissionReference])
  @@index([brokerId, status])
  @@index([accountId])
  @@index([instrumentId])
  @@map("orders")
}

model VerificationChallenge {
  id              String    @id
  brokerId        String    @map("broker_id")
  clientId        String    @map("client_id")
  accountId       String?   @map("account_id")
  purpose         String
  source          String
  method          String    @default("otp")
  destinationHint String?   @map("destination_hint")
  payloadHash     String    @map("payload_hash")
  codeHash        String    @map("code_hash")
  salt            String
  status          String    @default("pending")
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5) @map("max_attempts")
  expiresAt       DateTime  @map("expires_at")
  verifiedAt      DateTime? @map("verified_at")
  consumedAt      DateTime? @map("consumed_at")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  broker          Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order           Order?

  @@index([clientId, purpose, status])
  @@index([expiresAt, status])
  @@map("verification_challenges")
}

model OrderValidation {
  id        String   @id
  orderId   String   @map("order_id")
  ruleCode  String   @map("rule_code")
  label     String
  result    String
  message   String?
  checkedAt DateTime @default(now()) @map("checked_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_validations")
}

model OrderEvent {
  id         String   @id
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorId    String?  @map("actor_id")
  reason     String?
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?    @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model Trade {
  id                       String                   @id
  captureReference         String?                  @unique @map("capture_reference")
  orderId                  String                   @map("order_id")
  executionPrice           Decimal                  @map("execution_price") @db.Decimal(20, 6)
  quantityFilled           Decimal                  @map("quantity_filled") @db.Decimal(24, 8)
  grossAmount              Decimal                  @map("gross_amount") @db.Decimal(20, 4)
  fees                     Decimal                  @db.Decimal(20, 4)
  feeBreakdown             Json?                    @map("fee_breakdown")
  netAmount                Decimal                  @map("net_amount") @db.Decimal(20, 4)
  tradeDate                DateTime                 @map("trade_date") @db.Date
  settlementDate           DateTime                 @map("settlement_date") @db.Date
  capturedBy               String                   @map("captured_by")
  capturedAt               DateTime                 @default(now()) @map("captured_at")
  order                    Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  capturedByUser           User                     @relation("TradeCapturer", fields: [capturedBy], references: [id], onDelete: Restrict)
  settlement               Settlement?
  cashLedgerEntries        CashLedgerEntry[]
  securitiesLedgerEntries  SecuritiesLedgerEntry[]
  clientMoneyLedgerEntries ClientMoneyLedgerEntry[]
  pooledBankLedgerEntries  PooledBankLedgerEntry[]

  @@index([orderId])
  @@map("trades")
}

model ClientServiceRequest {
  id              String    @id
  brokerId        String    @map("broker_id")
  clientId        String    @map("client_id")
  accountId       String?   @map("account_id")
  orderId         String?   @map("order_id")
  requestType     String    @map("request_type")
  status          String    @default("open")
  subject         String
  description     String
  submittedBy     String    @map("submitted_by")
  assignedTo      String?   @map("assigned_to")
  resolutionNotes String?   @map("resolution_notes")
  resolvedBy      String?   @map("resolved_by")
  submittedAt     DateTime  @default(now()) @map("submitted_at")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  broker          Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  account         Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([brokerId, status, submittedAt])
  @@index([clientId, status])
  @@map("client_service_requests")
}

model ClientNote {
  id         String   @id
  clientId   String   @map("client_id")
  noteText   String   @map("note_text")
  category   String   @default("general")
  visibility String   @default("internal")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author     User     @relation("ClientNoteAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@map("client_notes")
}

model Settlement {
  id               String    @id
  tradeId          String    @unique @map("trade_id")
  status           String    @default("pending")
  settlementDate   DateTime  @map("settlement_date") @db.Date
  cashStatus       String    @default("pending") @map("cash_status")
  securitiesStatus String    @default("pending") @map("securities_status")
  exceptionNotes   String?   @map("exception_notes")
  confirmedBy      String?   @map("confirmed_by")
  confirmedAt      DateTime? @map("confirmed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  trade            Trade     @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  confirmedByUser  User?     @relation("SettlementConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@map("settlements")
}

model CashLedgerEntry {
  id                  String             @id
  accountId           String             @map("account_id")
  orderId             String?            @map("order_id")
  tradeId             String?            @map("trade_id")
  cashMovementId      String?            @map("cash_movement_id")
  pooledBankAccountId String?            @map("pooled_bank_account_id")
  entryType           String             @map("entry_type")
  amount              Decimal            @db.Decimal(20, 4)
  totalImpact         Decimal            @default(0) @map("total_impact") @db.Decimal(20, 4)
  availableImpact     Decimal            @default(0) @map("available_impact") @db.Decimal(20, 4)
  blockedImpact       Decimal            @default(0) @map("blocked_impact") @db.Decimal(20, 4)
  unsettledImpact     Decimal            @default(0) @map("unsettled_impact") @db.Decimal(20, 4)
  runningBalance      Decimal            @map("running_balance") @db.Decimal(20, 4)
  description         String
  reason              String?
  valueDate           DateTime           @map("value_date") @db.Date
  createdBy           String?            @map("created_by")
  createdAt           DateTime           @default(now()) @map("created_at")
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order               Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trade               Trade?             @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  cashMovement        CashMovement?      @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  pooledBankAccount   PooledBankAccount? @relation(fields: [pooledBankAccountId], references: [id], onDelete: SetNull)
  createdByUser       User?              @relation("CashLedgerCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([accountId, valueDate])
  @@index([orderId, createdAt])
  @@index([tradeId, createdAt])
  @@index([cashMovementId, createdAt])
  @@index([pooledBankAccountId, createdAt])
  @@map("cash_ledger_entries")
}

/// A safeguarded omnibus bank account holding client money. `bookBalance` is
/// FrankBroker's controlled internal bank-book balance; `statementBalance` is
/// the latest independently imported/confirmed bank balance used for reconciliation.
model PooledBankAccount {
  id                       String                   @id
  brokerId                 String                   @map("broker_id")
  bankName                 String                   @map("bank_name")
  accountName              String                   @map("account_name")
  accountNumberMasked      String                   @map("account_number_masked")
  currency                 String                   @default("ETB")
  purpose                  String                   @default("general")
  status                   String                   @default("active")
  bookBalance              Decimal                  @default(0) @map("book_balance") @db.Decimal(20, 4)
  statementBalance         Decimal                  @default(0) @map("statement_balance") @db.Decimal(20, 4)
  version                  Int                      @default(0)
  lastReconciledAt         DateTime?                @map("last_reconciled_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  broker                   Broker                   @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  positions                ClientMoneyPosition[]
  cashMovements            CashMovement[]
  ledgerEntries            PooledBankLedgerEntry[]
  cashLedgerEntries        CashLedgerEntry[]
  clientMoneyLedgerEntries ClientMoneyLedgerEntry[]

  @@unique([brokerId, bankName, accountNumberMasked])
  @@index([brokerId, status, purpose])
  @@map("pooled_bank_accounts")
}

/// Current beneficial ownership of one investor account inside one pooled bank
/// account. This snapshot may only change through a matching event ledger entry.
model ClientMoneyPosition {
  id                  String                   @id
  accountId           String                   @map("account_id")
  pooledBankAccountId String                   @map("pooled_bank_account_id")
  balance             Decimal                  @default(0) @db.Decimal(20, 4)
  version             Int                      @default(0)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  account             Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pooledBankAccount   PooledBankAccount        @relation(fields: [pooledBankAccountId], references: [id], onDelete: Restrict)
  ledgerEntries       ClientMoneyLedgerEntry[]

  @@unique([accountId, pooledBankAccountId])
  @@index([pooledBankAccountId])
  @@map("client_money_positions")
}

model CashMovement {
  id                       String                   @id
  brokerId                 String                   @map("broker_id")
  clientId                 String                   @map("client_id")
  accountId                String                   @map("account_id")
  pooledBankAccountId      String                   @map("pooled_bank_account_id")
  submissionReference      String                   @map("submission_reference")
  movementType             String                   @map("movement_type")
  amount                   Decimal                  @db.Decimal(20, 4)
  currency                 String                   @default("ETB")
  status                   String
  bankReference            String?                  @map("bank_reference")
  proofReference           String?                  @map("proof_reference")
  destinationBankName      String?                  @map("destination_bank_name")
  destinationAccountName   String?                  @map("destination_account_name")
  destinationAccountMasked String?                  @map("destination_account_masked")
  requestedByChannel       String                   @map("requested_by_channel")
  submittedByUserId        String?                  @map("submitted_by_user_id")
  reviewedByUserId         String?                  @map("reviewed_by_user_id")
  completedByUserId        String?                  @map("completed_by_user_id")
  submittedAt              DateTime                 @default(now()) @map("submitted_at")
  reviewedAt               DateTime?                @map("reviewed_at")
  completedAt              DateTime?                @map("completed_at")
  rejectionReason          String?                  @map("rejection_reason")
  failureReason            String?                  @map("failure_reason")
  notes                    String?
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  broker                   Broker                   @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client                   Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  account                  Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pooledBankAccount        PooledBankAccount        @relation(fields: [pooledBankAccountId], references: [id], onDelete: Restrict)
  submittedBy              User?                    @relation("CashMovementSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy               User?                    @relation("CashMovementReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  completedBy              User?                    @relation("CashMovementCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  cashLedgerEntries        CashLedgerEntry[]
  clientMoneyLedgerEntries ClientMoneyLedgerEntry[]
  pooledBankLedgerEntries  PooledBankLedgerEntry[]

  @@unique([brokerId, submissionReference])
  @@index([brokerId, status, submittedAt])
  @@index([clientId, submittedAt])
  @@index([accountId, status])
  @@map("cash_movements")
}

model ClientMoneyLedgerEntry {
  id                  String              @id
  positionId          String              @map("position_id")
  accountId           String              @map("account_id")
  pooledBankAccountId String              @map("pooled_bank_account_id")
  cashMovementId      String?             @map("cash_movement_id")
  orderId             String?             @map("order_id")
  tradeId             String?             @map("trade_id")
  entryType           String              @map("entry_type")
  amount              Decimal             @db.Decimal(20, 4)
  balanceImpact       Decimal             @map("balance_impact") @db.Decimal(20, 4)
  runningBalance      Decimal             @map("running_balance") @db.Decimal(20, 4)
  createdBy           String              @map("created_by")
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at")
  position            ClientMoneyPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  account             Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pooledBankAccount   PooledBankAccount   @relation(fields: [pooledBankAccountId], references: [id], onDelete: Restrict)
  cashMovement        CashMovement?       @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  order               Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trade               Trade?              @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  createdByUser       User                @relation("ClientMoneyLedgerCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([pooledBankAccountId, createdAt])
  @@index([cashMovementId])
  @@index([orderId, createdAt])
  @@index([tradeId, createdAt])
  @@map("client_money_ledger_entries")
}

model PooledBankLedgerEntry {
  id                  String            @id
  pooledBankAccountId String            @map("pooled_bank_account_id")
  cashMovementId      String?           @map("cash_movement_id")
  orderId             String?           @map("order_id")
  tradeId             String?           @map("trade_id")
  entryType           String            @map("entry_type")
  amount              Decimal           @db.Decimal(20, 4)
  balanceImpact       Decimal           @map("balance_impact") @db.Decimal(20, 4)
  runningBalance      Decimal           @map("running_balance") @db.Decimal(20, 4)
  bankReference       String?           @map("bank_reference")
  createdBy           String            @map("created_by")
  notes               String?
  createdAt           DateTime          @default(now()) @map("created_at")
  pooledBankAccount   PooledBankAccount @relation(fields: [pooledBankAccountId], references: [id], onDelete: Restrict)
  cashMovement        CashMovement?     @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  order               Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trade               Trade?            @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  createdByUser       User              @relation("PooledBankLedgerCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([pooledBankAccountId, createdAt])
  @@index([cashMovementId])
  @@index([orderId, createdAt])
  @@index([tradeId, createdAt])
  @@map("pooled_bank_ledger_entries")
}

model SecuritiesLedgerEntry {
  id              String     @id
  accountId       String     @map("account_id")
  instrumentId    String     @map("instrument_id")
  orderId         String?    @map("order_id")
  tradeId         String?    @map("trade_id")
  entryType       String     @map("entry_type")
  quantity        Decimal    @db.Decimal(24, 8)
  totalImpact     Decimal    @default(0) @map("total_impact") @db.Decimal(24, 8)
  availableImpact Decimal    @default(0) @map("available_impact") @db.Decimal(24, 8)
  blockedImpact   Decimal    @default(0) @map("blocked_impact") @db.Decimal(24, 8)
  unsettledImpact Decimal    @default(0) @map("unsettled_impact") @db.Decimal(24, 8)
  runningQuantity Decimal    @map("running_quantity") @db.Decimal(24, 8)
  description     String
  reason          String?
  valueDate       DateTime   @map("value_date") @db.Date
  createdBy       String     @map("created_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  account         Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  instrument      Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  order           Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trade           Trade?     @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  createdByUser   User       @relation("SecuritiesLedgerCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([accountId, instrumentId, valueDate])
  @@index([orderId, createdAt])
  @@index([tradeId, createdAt])
  @@map("securities_ledger_entries")
}

model ReconciliationBatch {
  id               String                    @id
  brokerId         String                    @map("broker_id")
  batchDate        DateTime                  @map("batch_date") @db.Date
  fileName         String?                   @map("file_name")
  source           String                    @default("manual_upload")
  totalRecords     Int                       @default(0) @map("total_records")
  matchedRecords   Int                       @default(0) @map("matched_records")
  exceptionRecords Int                       @default(0) @map("exception_records")
  status           String                    @default("processing")
  uploadedBy       String                    @map("uploaded_by")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  broker           Broker                    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  uploadedByUser   User                      @relation("BatchUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  exceptions       ReconciliationException[]

  @@index([brokerId, batchDate])
  @@map("reconciliation_batches")
}

model ReconciliationException {
  id              String              @id
  batchId         String              @map("batch_id")
  reference       String
  exceptionType   String              @map("exception_type")
  expectedValue   String?             @map("expected_value")
  actualValue     String?             @map("actual_value")
  status          String              @default("open")
  resolutionNotes String?             @map("resolution_notes")
  resolvedBy      String?             @map("resolved_by")
  resolvedAt      DateTime?           @map("resolved_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  batch           ReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  resolvedByUser  User?               @relation("ExceptionResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([batchId, status])
  @@map("reconciliation_exceptions")
}

model AuditLog {
  id            String   @id
  brokerId      String?  @map("broker_id")
  actorId       String?  @map("actor_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  summary       String
  reason        String?
  previousValue String?  @map("previous_value")
  newValue      String?  @map("new_value")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")
  broker        Broker?  @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([brokerId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id         String    @id
  dedupeKey  String?   @unique @map("dedupe_key") // set for scheduled reminders so re-runs don't duplicate
  brokerId   String?   @map("broker_id")
  scope      String // "broker" | "investor" | "platform"
  roles      String? // comma-separated broker roles; null = all broker staff
  clientId   String?   @map("client_id")
  category   String // order | kyc | settlement | trade | reconciliation | account | system
  severity   String    @default("info") // info | success | warning | critical
  title      String
  body       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  link       String?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([brokerId, scope, createdAt])
  @@index([clientId, createdAt])
  @@map("notifications")
}
