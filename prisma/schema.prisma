  valueDate       DateTime   @map("value_date") @db.Date
  createdBy       String     @map("created_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  account         Account    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  instrument      Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  order           Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trade           Trade?     @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  createdByUser   User       @relation("SecuritiesLedgerCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([accountId, instrumentId, valueDate])
  @@index([orderId, createdAt])
  @@index([tradeId, createdAt])
  @@map("securities_ledger_entries")
}

model ReconciliationBatch {
  id                String                    @id
  brokerId          String                    @map("broker_id")
  batchDate         DateTime                  @map("batch_date") @db.Date
  fileName          String?                   @map("file_name")
  source            String                    @default("manual_upload")
  totalRecords      Int                       @default(0) @map("total_records")
  matchedRecords    Int                       @default(0) @map("matched_records")
  exceptionRecords  Int                       @default(0) @map("exception_records")
  status            String                    @default("processing")
  uploadedBy        String                    @map("uploaded_by")
  reviewedBy        String?                   @map("reviewed_by")
  reviewedAt        DateTime?                 @map("reviewed_at")
  evidenceReference String?                   @map("evidence_reference")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  broker            Broker                    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  uploadedByUser    User                      @relation("BatchUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  reviewedByUser    User?                     @relation("ReconciliationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  exceptions        ReconciliationException[]

  @@index([brokerId, batchDate])
  @@map("reconciliation_batches")
}

model ReconciliationException {
  id              String              @id
  batchId         String              @map("batch_id")
  reference       String
  exceptionType   String              @map("exception_type")
  expectedValue   String?             @map("expected_value")
  actualValue     String?             @map("actual_value")
  status          String              @default("open")
  resolutionNotes String?             @map("resolution_notes")
  resolvedBy      String?             @map("resolved_by")
  resolvedAt      DateTime?           @map("resolved_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  batch           ReconciliationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  resolvedByUser  User?               @relation("ExceptionResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([batchId, status])
  @@map("reconciliation_exceptions")
}

model AuditLog {
  id            String   @id
  brokerId      String?  @map("broker_id")
  actorId       String?  @map("actor_id")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  summary       String
  reason        String?
  previousValue String?  @map("previous_value")
  newValue      String?  @map("new_value")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")
  broker        Broker?  @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([brokerId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id         String    @id
  dedupeKey  String?   @unique @map("dedupe_key") // set for scheduled reminders so re-runs don't duplicate
  brokerId   String?   @map("broker_id")
  scope      String // "broker" | "investor" | "platform"
  roles      String? // comma-separated broker roles; null = all broker staff
  clientId   String?   @map("client_id")
  category   String // order | kyc | settlement | trade | reconciliation | account | system
  severity   String    @default("info") // info | success | warning | critical
  title      String
  body       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  link       String?
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([brokerId, scope, createdAt])
  @@index([clientId, createdAt])
  @@map("notifications")
}

/// A secure conversation between one investor and their broker. Investor-visible
/// messages and broker-only internal notes live in the same thread; visibility is
/// enforced per message (see lib/crm/visibility.ts).
model CommunicationThread {
  id                  String                    @id
  brokerId            String                    @map("broker_id")
  clientId            String                    @map("client_id")
  accountId           String?                   @map("account_id")
  subject             String
  category            String                    @default("general")
  priority            String                    @default("normal")
  status              String                    @default("open")
  relatedType         String?                   @map("related_type")
  relatedId           String?                   @map("related_id")
  assignedToUserId    String?                   @map("assigned_to_user_id")
  messageCount        Int                       @default(0) @map("message_count")
  lastMessageAt       DateTime                  @default(now()) @map("last_message_at")
  lastMessagePreview  String?                   @map("last_message_preview")
  brokerUnreadCount   Int                       @default(0) @map("broker_unread_count")
  investorUnreadCount Int                       @default(0) @map("investor_unread_count")
  openedBy            String                    @default("investor") @map("opened_by")
  resolvedAt          DateTime?                 @map("resolved_at")
  closedAt            DateTime?                 @map("closed_at")
  version             Int                       @default(0)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  broker              Broker                    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client              Client                    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  account             Account?                  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  assignedTo          User?                     @relation("ThreadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages            CommunicationMessage[]
  attachments         CommunicationAttachment[]
  tasks               CrmTask[]
  serviceCase         ServiceCase?
  serviceRequest      ClientServiceRequest?

  @@index([brokerId, status, lastMessageAt])
  @@index([clientId, lastMessageAt])
  @@index([brokerId, assignedToUserId, status])
  @@index([relatedType, relatedId])
  @@map("communication_threads")
}

/// One message in a thread. `visibility` is the privacy boundary: "shared" is
/// visible to the investor, "internal" is broker-only and must never leave an
/// investor-facing endpoint.
model CommunicationMessage {
  id           String                    @id
  threadId     String                    @map("thread_id")
  visibility   String                    @default("shared")
  authorType   String                    @map("author_type")
  authorUserId String?                   @map("author_user_id")
  body         String
  createdAt    DateTime                  @default(now()) @map("created_at")
  thread       CommunicationThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author       User?                     @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  attachments  CommunicationAttachment[]

  @@index([threadId, visibility, createdAt])
  @@map("communication_messages")
}

/// Attachment metadata. Bytes live in CommunicationAttachmentContent so listing a
/// thread never loads blobs. Mirrors the ClientDocument / ClientDocumentContent split.
model CommunicationAttachment {
  id           String                          @id
  brokerId     String                          @map("broker_id")
  clientId     String                          @map("client_id")
  threadId     String                          @map("thread_id")
  messageId    String                          @map("message_id")
  originalName String                          @map("original_name")
  mimeType     String                          @map("mime_type")
  sizeBytes    Int                             @map("size_bytes")
  visibility   String                          @default("shared")
  uploadedAt   DateTime                        @default(now()) @map("uploaded_at")
  thread       CommunicationThread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message      CommunicationMessage            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content      CommunicationAttachmentContent?

  @@index([threadId, visibility])
  @@index([brokerId, uploadedAt])
  @@map("communication_attachments")
}

model CommunicationAttachmentContent {
  attachmentId String                  @id @map("attachment_id")
  bytes        Bytes
  attachment   CommunicationAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@map("communication_attachment_contents")
}

/// A follow-up a broker user owes on an investor's behalf. Deliberately narrow:
/// this is servicing accountability, not a project-management system.
model CrmTask {
  id                String               @id
  brokerId          String               @map("broker_id")
  clientId          String               @map("client_id")
  threadId          String?              @map("thread_id")
  caseId            String?              @map("case_id")
  relatedType       String?              @map("related_type")
  relatedId         String?              @map("related_id")
  title             String
  description       String?
  taskType          String               @default("follow_up") @map("task_type")
  assignedToUserId  String?              @map("assigned_to_user_id")
  createdByUserId   String?              @map("created_by_user_id")
  dueDate           DateTime?            @map("due_date") @db.Date
  priority          String               @default("normal")
  status            String               @default("open")
  escalated         Boolean              @default(false)
  completedAt       DateTime?            @map("completed_at")
  completedByUserId String?              @map("completed_by_user_id")
  completionNote    String?              @map("completion_note")
  version           Int                  @default(0)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  broker            Broker               @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  thread            CommunicationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  case              ServiceCase?         @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedTo        User?                @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdBy         User?                @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedBy       User?                @relation("TaskCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([brokerId, status, dueDate])
  @@index([brokerId, assignedToUserId, status])
  @@index([clientId, createdAt])
  @@index([threadId])
  @@map("crm_tasks")
}

/// A complaint or formal service case escalated from a conversation. Structured
/// enough for accountable handling and extensible toward SLA and regulatory
/// reporting, without becoming a full complaints suite.
model ServiceCase {
  id                 String               @id
  brokerId           String               @map("broker_id")
  clientId           String               @map("client_id")
  threadId           String?              @unique @map("thread_id")
  category           String               @default("complaint")
  severity           String               @default("medium")
  status             String               @default("new")
  subject            String
  assignedToUserId   String?              @map("assigned_to_user_id")
  openedAt           DateTime             @default(now()) @map("opened_at")
  targetResolutionAt DateTime?            @map("target_resolution_at")
  internalFindings   String?              @map("internal_findings")
  resolutionSummary  String?              @map("resolution_summary")
  regulatoryStatus   String               @default("pending") @map("regulatory_status")
  regulatoryStatusAt DateTime?            @map("regulatory_status_at")
  regulatoryComment  String?              @map("regulatory_comment")
  resolvedAt         DateTime?            @map("resolved_at")
  closedAt           DateTime?            @map("closed_at")
  version            Int                  @default(0)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  broker             Broker               @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  thread             CommunicationThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  assignedTo         User?                @relation("CaseOwner", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  tasks              CrmTask[]

  @@index([brokerId, status, openedAt])
  @@index([clientId, openedAt])
  @@map("service_cases")
}

/// A point-in-time report produced from brokerage records held by Frank. The
/// snapshot allows the downloaded report to be reproduced after the book changes.
model ComplianceReport {
  id                  String    @id
  brokerId            String    @map("broker_id")
  clientId            String?   @map("client_id")
  reportType          String    @map("report_type")
  periodStart         DateTime  @map("period_start") @db.Date
  periodEnd           DateTime  @map("period_end") @db.Date
  status              String    @default("prepared")
  snapshot            Json
  validation          Json
  preparedBy          String    @map("prepared_by")
  reviewedBy          String?   @map("reviewed_by")
  reviewedAt          DateTime? @map("reviewed_at")
  submittedBy         String?   @map("submitted_by")
  submittedAt         DateTime? @map("submitted_at")
  submissionReference String?   @map("submission_reference")
  submissionNote      String?   @map("submission_note")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  broker              Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client              Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  preparer            User      @relation("ComplianceReportPreparer", fields: [preparedBy], references: [id], onDelete: Restrict)
  reviewer            User?     @relation("ComplianceReportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  submitter           User?     @relation("ComplianceReportSubmitter", fields: [submittedBy], references: [id], onDelete: SetNull)

  @@index([brokerId, reportType, periodEnd])
  @@index([brokerId, status, createdAt])
  @@index([clientId, createdAt])
  @@map("compliance_reports")
}

/// A broker-controlled 24-hour escalation. Frank records the clock, evidence,
/// decision and receipt but does not make the regulatory determination.
model ComplianceEscalation {
  id                  String    @id
  brokerId            String    @map("broker_id")
  eventType           String    @map("event_type")
  subject             String
  summary             String
  linkedEntityType    String?   @map("linked_entity_type")
  linkedEntityId      String?   @map("linked_entity_id")
  awarenessAt         DateTime  @map("awareness_at")
  dueAt               DateTime  @map("due_at")
  status              String    @default("open")
  decision            String?
  submissionReference String?   @map("submission_reference")
  submittedAt         DateTime? @map("submitted_at")
  createdBy           String    @map("created_by")
  reviewedBy          String?   @map("reviewed_by")
  reviewedAt          DateTime? @map("reviewed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  broker              Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  creator             User      @relation("ComplianceEscalationCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  reviewer            User?     @relation("ComplianceEscalationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([brokerId, status, dueAt])
  @@index([brokerId, eventType, awarenessAt])
  @@map("compliance_escalations")
}

/// Evidence that a client and their ownership or control parties were screened
/// by the broker or an external provider. Frank does not maintain a watchlist.
model ClientScreening {
  id            String   @id
  brokerId      String   @map("broker_id")
  clientId      String   @map("client_id")
  screeningType String   @default("sanctions_pep") @map("screening_type")
  provider      String
  result        String
  reference     String?
  notes         String?
  screenedAt    DateTime @map("screened_at")
  recordedBy    String   @map("recorded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  broker        Broker   @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recorder      User     @relation("ClientScreeningRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([brokerId, clientId, screenedAt])
  @@index([brokerId, result, screenedAt])
  @@map("client_screenings")
}

/// Who owns the relationship with an investor. History is preserved by ending a
/// row (`endedAt`) rather than overwriting it, so reassignment is auditable.
model InvestorAssignment {
  id               String    @id
  brokerId         String    @map("broker_id")
  clientId         String    @map("client_id")
  primaryOfficerId String?   @map("primary_officer_id")
  backupOfficerId  String?   @map("backup_officer_id")
  team             String?
  branch           String?
  note             String?
  assignedByUserId String?   @map("assigned_by_user_id")
  assignedAt       DateTime  @default(now()) @map("assigned_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  broker           Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  primaryOfficer   User?     @relation("AssignmentPrimary", fields: [primaryOfficerId], references: [id], onDelete: SetNull)
  backupOfficer    User?     @relation("AssignmentBackup", fields: [backupOfficerId], references: [id], onDelete: SetNull)
  assignedBy       User?     @relation("AssignmentRecorder", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([brokerId, clientId, assignedAt])
  @@index([brokerId, primaryOfficerId, endedAt])
  @@index([clientId, endedAt])
  @@map("investor_assignments")
}
