  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author     User     @relation("ClientNoteAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@map("client_notes")
}

/// Issuer or fixed-income event. Dates and terms are preserved exactly as
/// announced; entitlement snapshots never infer an ex-date or record date.
model CorporateAction {
  id                    String                       @id
  brokerId              String                       @map("broker_id")
  instrumentId          String                       @map("instrument_id")
  actionType             String                       @map("action_type")
  status                 String                       @default("draft")
  announcementDate       DateTime?                    @map("announcement_date") @db.Date
  exDate                 DateTime?                    @map("ex_date") @db.Date
  recordDate             DateTime                     @map("record_date") @db.Date
  electionDeadline       DateTime?                    @map("election_deadline") @db.Date
  paymentDate            DateTime                     @map("payment_date") @db.Date
  currency               String                       @default("ETB")
  cashRatePerUnit        Decimal?                     @map("cash_rate_per_unit") @db.Decimal(20, 8)
  securityRatioNumerator Decimal?                     @map("security_ratio_numerator") @db.Decimal(24, 8)
  securityRatioDenominator Decimal?                   @map("security_ratio_denominator") @db.Decimal(24, 8)
  defaultElection        String                       @default("cash") @map("default_election")
  supportsReinvestment   Boolean                      @default(false) @map("supports_reinvestment")
  taxTreatment           String                       @default("policy") @map("tax_treatment")
  sourceReference        String                       @map("source_reference")
  sourceEvidence         Json?                        @map("source_evidence")
  termsSnapshot          Json?                        @map("terms_snapshot")
  createdBy              String                       @map("created_by")
  approvedBy             String?                      @map("approved_by")
  approvedAt             DateTime?                    @map("approved_at")
  version                Int                          @default(1)
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  broker                 Broker                       @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  instrument             Instrument                   @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  entitlements           CorporateActionEntitlement[]

  @@unique([brokerId, sourceReference])
  @@index([brokerId, status, paymentDate])
  @@index([instrumentId, recordDate])
  @@map("corporate_actions")
}

/// One immutable record-date position per client account. Internal ledger and
/// external CSD quantities are kept separately so a break cannot be hidden.
model CorporateActionEntitlement {
  id                    String          @id
  corporateActionId     String          @map("corporate_action_id")
  accountId             String          @map("account_id")
  ledgerQuantity        Decimal         @map("ledger_quantity") @db.Decimal(24, 8)
  externalQuantity      Decimal?        @map("external_quantity") @db.Decimal(24, 8)
  eligibleQuantity      Decimal         @map("eligible_quantity") @db.Decimal(24, 8)
  positionSource        String          @map("position_source")
  reconciliationStatus  String          @default("unverified") @map("reconciliation_status")
  grossCash             Decimal?        @map("gross_cash") @db.Decimal(20, 4)
  withholdingAmount     Decimal?        @map("withholding_amount") @db.Decimal(20, 4)
  netCash               Decimal?        @map("net_cash") @db.Decimal(20, 4)
  withholdingStatus     String          @default("unconfigured") @map("withholding_status")
  securityQuantity      Decimal?        @map("security_quantity") @db.Decimal(24, 8)
  election              String          @default("cash")
  electionRecordedAt    DateTime?       @map("election_recorded_at")
  electionEvidence      String?         @map("election_evidence")
  status                String          @default("calculated")
  paymentReference      String?         @map("payment_reference")
  paidAt                DateTime?       @map("paid_at")
  exceptionReason       String?         @map("exception_reason")
  calculationSnapshot   Json?           @map("calculation_snapshot")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  corporateAction       CorporateAction @relation(fields: [corporateActionId], references: [id], onDelete: Cascade)
  account               Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  taxCalculations       TaxCalculation[]
  realizedGainAllocations RealizedGainAllocation[]

  @@unique([corporateActionId, accountId])
  @@index([accountId, status])
  @@map("corporate_action_entitlements")
}

/// Versioned, effective-dated tax interpretation. A missing policy means
/// "unknown", never an implicit zero rate.
model TaxPolicyVersion {
  id                  String           @id
  brokerId            String           @map("broker_id")
  name                String
  version             String
  appliesTo           String           @map("applies_to")
  assetClass          String?          @map("asset_class")
  ratePct             Decimal          @map("rate_pct") @db.Decimal(8, 4)
  calculationBasis    String           @default("gain") @map("calculation_basis")
  withholdingRequired Boolean          @default(false) @map("withholding_required")
  status              String           @default("draft")
  effectiveFrom       DateTime         @map("effective_from") @db.Date
  effectiveTo         DateTime?        @map("effective_to") @db.Date
  retrospectiveFrom   DateTime?        @map("retrospective_from") @db.Date
  legalReference      String           @map("legal_reference")
  sourceEvidence      Json?            @map("source_evidence")
  approvedBy          String?          @map("approved_by")
  approvedAt          DateTime?        @map("approved_at")
  createdBy           String           @map("created_by")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  broker              Broker           @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  calculations        TaxCalculation[]

  @@unique([brokerId, appliesTo, assetClass, version])
  @@index([brokerId, status, appliesTo, effectiveFrom])
  @@map("tax_policy_versions")
}

/// Acquisition layer. Imported/dematerialized positions may intentionally have
/// null cost until documentary evidence is supplied and reviewed.
model TaxLot {
  id                  String                   @id
  accountId           String                   @map("account_id")
  instrumentId        String                   @map("instrument_id")
  acquisitionTradeId  String?                  @unique @map("acquisition_trade_id")
  acquisitionDate     DateTime?                @map("acquisition_date") @db.Date
  originalQuantity    Decimal                  @map("original_quantity") @db.Decimal(24, 8)
  remainingQuantity   Decimal                  @map("remaining_quantity") @db.Decimal(24, 8)
  acquisitionGross    Decimal?                 @map("acquisition_gross") @db.Decimal(20, 4)
  acquisitionFees     Decimal?                 @map("acquisition_fees") @db.Decimal(20, 4)
  costBasis           Decimal?                 @map("cost_basis") @db.Decimal(20, 4)
  unitCost            Decimal?                 @map("unit_cost") @db.Decimal(20, 8)
  basisStatus         String                   @default("unknown") @map("basis_status")
  basisSource         String                   @map("basis_source")
  sourceReference     String?                  @map("source_reference")
  evidenceReference   String?                  @map("evidence_reference")
  verifiedBy          String?                  @map("verified_by")
  verifiedAt          DateTime?                @map("verified_at")
  notes               String?
  version             Int                      @default(1)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  account             Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  instrument          Instrument               @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  acquisitionTrade    Trade?                   @relation(fields: [acquisitionTradeId], references: [id], onDelete: Restrict)
  dispositions        RealizedGainAllocation[]

  @@index([accountId, instrumentId, acquisitionDate])
  @@index([basisStatus, remainingQuantity])
  @@map("tax_lots")
}

/// Economic disposal allocation. Tax calculations are append-only revisions,
/// allowing future or retrospective guidance without changing the trade facts.
model RealizedGainAllocation {
  id                  String           @id
  saleTradeId         String?          @map("sale_trade_id")
  corporateActionEntitlementId String? @map("corporate_action_entitlement_id")
  taxLotId            String           @map("tax_lot_id")
  quantity            Decimal          @db.Decimal(24, 8)
  grossProceeds       Decimal          @map("gross_proceeds") @db.Decimal(20, 4)
  allocatedFees       Decimal          @map("allocated_fees") @db.Decimal(20, 4)
  netProceeds         Decimal          @map("net_proceeds") @db.Decimal(20, 4)
  costBasis           Decimal?         @map("cost_basis") @db.Decimal(20, 4)
  realizedGain        Decimal?         @map("realized_gain") @db.Decimal(20, 4)
  basisStatus         String           @map("basis_status")
  status              String           @default("provisional")
  calculationSnapshot Json?            @map("calculation_snapshot")
  createdAt           DateTime         @default(now()) @map("created_at")
  saleTrade           Trade?           @relation(fields: [saleTradeId], references: [id], onDelete: Restrict)
  corporateActionEntitlement CorporateActionEntitlement? @relation(fields: [corporateActionEntitlementId], references: [id], onDelete: Restrict)
  taxLot              TaxLot           @relation(fields: [taxLotId], references: [id], onDelete: Restrict)
  taxCalculations     TaxCalculation[]

  @@unique([saleTradeId, taxLotId])
  @@unique([corporateActionEntitlementId, taxLotId])
  @@index([saleTradeId])
  @@index([basisStatus, createdAt])
  @@map("realized_gain_allocations")
}

model TaxCalculation {
  id                         String                      @id
  realizedGainAllocationId   String?                     @map("realized_gain_allocation_id")
  corporateActionEntitlementId String?                   @map("corporate_action_entitlement_id")
  taxPolicyVersionId         String                      @map("tax_policy_version_id")
  revision                   Int                         @default(1)
  taxableAmount              Decimal                     @map("taxable_amount") @db.Decimal(20, 4)
  ratePct                    Decimal                     @map("rate_pct") @db.Decimal(8, 4)
  taxAmount                  Decimal                     @map("tax_amount") @db.Decimal(20, 4)
  status                     String                      @default("estimate")
  supersedesId               String?                     @map("supersedes_id")
  calculationSnapshot        Json?                       @map("calculation_snapshot")
  calculatedAt               DateTime                    @default(now()) @map("calculated_at")
  realizedGainAllocation     RealizedGainAllocation?     @relation(fields: [realizedGainAllocationId], references: [id], onDelete: Restrict)
  corporateActionEntitlement CorporateActionEntitlement? @relation(fields: [corporateActionEntitlementId], references: [id], onDelete: Restrict)
  policy                     TaxPolicyVersion            @relation(fields: [taxPolicyVersionId], references: [id], onDelete: Restrict)

  @@unique([realizedGainAllocationId, taxPolicyVersionId, revision])
  @@unique([corporateActionEntitlementId, taxPolicyVersionId, revision])
  @@index([taxPolicyVersionId, calculatedAt])
  @@map("tax_calculations")
}

model Settlement {
  id               String         @id
  tradeId          String         @unique @map("trade_id")
  status           String         @default("pending")
  settlementDate   DateTime       @map("settlement_date") @db.Date
  cashStatus       String         @default("pending") @map("cash_status")
  securitiesStatus String         @default("pending") @map("securities_status")
  exceptionNotes   String?        @map("exception_notes")
  confirmedBy      String?        @map("confirmed_by")
  confirmedAt      DateTime?      @map("confirmed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  trade            Trade          @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  confirmedByUser  User?          @relation("SettlementConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)
  journalEntries   JournalEntry[]

  @@map("settlements")
}

model CashLedgerEntry {
  id                  String             @id
  accountId           String             @map("account_id")
  orderId             String?            @map("order_id")
  tradeId             String?            @map("trade_id")
  cashMovementId      String?            @map("cash_movement_id")
  pooledBankAccountId String?            @map("pooled_bank_account_id")
  entryType           String             @map("entry_type")
  amount              Decimal            @db.Decimal(20, 4)
  totalImpact         Decimal            @default(0) @map("total_impact") @db.Decimal(20, 4)
  availableImpact     Decimal            @default(0) @map("available_impact") @db.Decimal(20, 4)
  blockedImpact       Decimal            @default(0) @map("blocked_impact") @db.Decimal(20, 4)
  unsettledImpact     Decimal            @default(0) @map("unsettled_impact") @db.Decimal(20, 4)
  runningBalance      Decimal            @map("running_balance") @db.Decimal(20, 4)
  description         String
  reason              String?
  valueDate           DateTime           @map("value_date") @db.Date
  createdBy           String?            @map("created_by")
  createdAt           DateTime           @default(now()) @map("created_at")
  account             Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order               Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  trade               Trade?             @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  cashMovement        CashMovement?      @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)
  pooledBankAccount   PooledBankAccount? @relation(fields: [pooledBankAccountId], references: [id], onDelete: SetNull)
  createdByUser       User?              @relation("CashLedgerCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([accountId, valueDate])
  @@index([orderId, createdAt])
  @@index([tradeId, createdAt])
  @@index([cashMovementId, createdAt])
  @@index([pooledBankAccountId, createdAt])
  @@map("cash_ledger_entries")
}

/// A safeguarded omnibus bank account holding client money. `bookBalance` is
/// FrankBroker's controlled internal bank-book balance; `statementBalance` is
/// the latest independently imported/confirmed bank balance used for reconciliation.
model PooledBankAccount {
  id                       String                   @id
  brokerId                 String                   @map("broker_id")
  bankName                 String                   @map("bank_name")
  accountName              String                   @map("account_name")
  accountNumberMasked      String                   @map("account_number_masked")
  currency                 String                   @default("ETB")
  purpose                  String                   @default("general")
  status                   String                   @default("active")
  bookBalance              Decimal                  @default(0) @map("book_balance") @db.Decimal(20, 4)
  statementBalance         Decimal                  @default(0) @map("statement_balance") @db.Decimal(20, 4)
  version                  Int                      @default(0)
  lastReconciledAt         DateTime?                @map("last_reconciled_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  broker                   Broker                   @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  positions                ClientMoneyPosition[]
  cashMovements            CashMovement[]
  ledgerEntries            PooledBankLedgerEntry[]
  cashLedgerEntries        CashLedgerEntry[]
  clientMoneyLedgerEntries ClientMoneyLedgerEntry[]
  journalLines             JournalLine[]

  @@unique([brokerId, bankName, accountNumberMasked])
  @@index([brokerId, status, purpose])
  @@map("pooled_bank_accounts")
}

/// Current beneficial ownership of one investor account inside one pooled bank
/// account. This snapshot may only change through a matching event ledger entry.
model ClientMoneyPosition {
  id                  String                   @id
  accountId           String                   @map("account_id")
  pooledBankAccountId String                   @map("pooled_bank_account_id")
  balance             Decimal                  @default(0) @db.Decimal(20, 4)
  version             Int                      @default(0)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  account             Account                  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pooledBankAccount   PooledBankAccount        @relation(fields: [pooledBankAccountId], references: [id], onDelete: Restrict)
  ledgerEntries       ClientMoneyLedgerEntry[]

  @@unique([accountId, pooledBankAccountId])
  @@index([pooledBankAccountId])
  @@map("client_money_positions")
}

model CashMovement {
  id                        String                          @id
  brokerId                  String                          @map("broker_id")
  clientId                  String                          @map("client_id")
  accountId                 String                          @map("account_id")
  pooledBankAccountId       String                          @map("pooled_bank_account_id")
  submissionReference       String                          @map("submission_reference")
  movementType              String                          @map("movement_type")
  amount                    Decimal                         @db.Decimal(20, 4)
  currency                  String                          @default("ETB")
  status                    String
  bankReference             String?                         @map("bank_reference")
  proofReference            String?                         @map("proof_reference")
  destinationBankName       String?                         @map("destination_bank_name")
  destinationAccountName    String?                         @map("destination_account_name")
  destinationAccountMasked  String?                         @map("destination_account_masked")
  linkedBankAccountId       String?                         @map("linked_bank_account_id")
  sourceLinkedBankAccountId String?                         @map("source_linked_bank_account_id")
  requestedByChannel        String                          @map("requested_by_channel")
  submittedByUserId         String?                         @map("submitted_by_user_id")
  reviewedByUserId          String?                         @map("reviewed_by_user_id")
  completedByUserId         String?                         @map("completed_by_user_id")
  submittedAt               DateTime                        @default(now()) @map("submitted_at")
  reviewedAt                DateTime?                       @map("reviewed_at")
  completedAt               DateTime?                       @map("completed_at")
  rejectionReason           String?                         @map("rejection_reason")
  failureReason             String?                         @map("failure_reason")
  notes                     String?
  createdAt                 DateTime                        @default(now()) @map("created_at")
  updatedAt                 DateTime                        @updatedAt @map("updated_at")
  broker                    Broker                          @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client                    Client                          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  account                   Account                         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  pooledBankAccount         PooledBankAccount               @relation(fields: [pooledBankAccountId], references: [id], onDelete: Restrict)
  linkedBankAccount         LinkedBankAccount?              @relation("CashDestinationBank", fields: [linkedBankAccountId], references: [id], onDelete: SetNull)
  sourceLinkedBankAccount   LinkedBankAccount?              @relation("CashSourceBank", fields: [sourceLinkedBankAccountId], references: [id], onDelete: SetNull)
  submittedBy               User?                           @relation("CashMovementSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy                User?                           @relation("CashMovementReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  completedBy               User?                           @relation("CashMovementCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  proof                     CashMovementProof?
  cashLedgerEntries         CashLedgerEntry[]
  clientMoneyLedgerEntries  ClientMoneyLedgerEntry[]
  pooledBankLedgerEntries   PooledBankLedgerEntry[]
  monitoringAlerts          MonitoringAlert[]
  withdrawalException       WithdrawalDestinationException?
  journalEntries            JournalEntry[]
  paymentProviderEvents     PaymentProviderEvent[]

  @@unique([brokerId, submissionReference])
  @@index([brokerId, status, submittedAt])
  @@index([clientId, submittedAt])
  @@index([accountId, status])
  @@index([linkedBankAccountId])
  @@index([sourceLinkedBankAccountId])
  @@map("cash_movements")
}

/// Immutable evidence received from a payment provider. The cash movement and
/// ledgers remain the books of record; this row preserves what the provider
/// said, makes webhook redelivery idempotent, and records when it was applied.
model PaymentProviderEvent {
  id                    String        @id
  brokerId              String        @map("broker_id")
  cashMovementId        String?       @map("cash_movement_id")
  provider              String
  providerEventId       String        @map("provider_event_id")
  transactionId         String?       @map("transaction_id")
  merchantReference     String?       @map("merchant_reference")
  eventType             String        @map("event_type")
  providerStatus        String        @map("provider_status")
  grossAmount           Decimal?      @map("gross_amount") @db.Decimal(20, 4)
  providerFee           Decimal?      @map("provider_fee") @db.Decimal(20, 4)
  netAmount             Decimal?      @map("net_amount") @db.Decimal(20, 4)
  currency              String?
  settlementBatchId     String?       @map("settlement_batch_id")
  destinationAccountRef String?       @map("destination_account_ref")
  finalityAt            DateTime?     @map("finality_at")
  originalTransactionId String?       @map("original_transaction_id")
  payloadHash           String        @map("payload_hash")
  payload               Json?
  processingStatus      String        @default("received") @map("processing_status")
  failureReason         String?       @map("failure_reason")
  receivedAt            DateTime      @default(now()) @map("received_at")
  processedAt           DateTime?     @map("processed_at")
  broker                Broker        @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  cashMovement          CashMovement? @relation(fields: [cashMovementId], references: [id], onDelete: SetNull)

  @@unique([brokerId, provider, providerEventId])
  @@index([brokerId, transactionId])
  @@index([brokerId, settlementBatchId])
  @@index([brokerId, processingStatus, receivedAt])
  @@map("payment_provider_events")
}

/// Versioned broker accounting decisions. Runtime posting code reads the
/// effective approved version; historical versions remain available to explain
/// why an event was accounted for as it was at the time.
model AccountingPolicyVersion {
  id                           String    @id
  brokerId                     String    @map("broker_id")
  version                      String
  effectiveFrom                DateTime  @map("effective_from") @db.Date
  status                       String    @default("draft")
  clientMoneyPresentation      String    @map("client_money_presentation")
  gatewayRecognitionPoint      String    @map("gateway_recognition_point")
  depositAvailabilityPoint     String    @map("deposit_availability_point")
  gatewayFeeTreatment          String    @map("gateway_fee_treatment")
  protectedResourceDefinition  String    @map("protected_resource_definition")
  feeSweepTiming               String    @map("fee_sweep_timing")
  withdrawalDerecognitionPoint String    @map("withdrawal_derecognition_point")
  rationale                    String?
  approvedBy                   String?   @map("approved_by")
  approvedAt                   DateTime? @map("approved_at")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")
  broker                       Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  approvedByUser               User?     @relation("AccountingPolicyApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@unique([brokerId, version])
  @@index([brokerId, status, effectiveFrom])
  @@map("accounting_policy_versions")
}

/// Structured ownership references used for exact, privacy-preserving shared-
/// identifier monitoring. Raw identity documents remain in the document vault.
model BeneficialOwner {
  id                String    @id
  brokerId          String    @map("broker_id")
  clientId          String    @map("client_id")
  displayName       String    @map("display_name")
  ownershipPercent  Decimal?  @map("ownership_percent") @db.Decimal(8, 4)
  identityReference String?   @map("identity_reference")
  taxReference      String?   @map("tax_reference")
  identifierLast7   String?   @map("identifier_last7")
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  broker            Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([brokerId, identityReference])
  @@index([brokerId, taxReference])
  @@map("beneficial_owners")
}

/// Immutable versions of configurable monitoring rules. Activating a version
/// ends the previous version; prior alert decisions remain reproducible.
model MonitoringRuleVersion {
  id              String    @id
  brokerId        String    @map("broker_id")
  ruleCode        String    @map("rule_code")
  category        String
  version         Int
  enabled         Boolean   @default(true)
  configuration   Json
  effectiveFrom   DateTime  @default(now()) @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  changedByUserId String    @map("changed_by_user_id")
  changeReason    String    @map("change_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  broker          Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)

  @@unique([brokerId, ruleCode, version])
  @@index([brokerId, category, effectiveTo])
  @@map("monitoring_rule_versions")
}

model MonitoringCase {
  id               String                @id
  brokerId         String                @map("broker_id")
  category         String
  referenceNumber  String                @map("reference_number")
  title            String
  status           String                @default("open")
  priority         String                @default("medium")
  assignedToUserId String?               @map("assigned_to_user_id")
  dueAt            DateTime?             @map("due_at")
  openedByUserId   String                @map("opened_by_user_id")
  resolution       String?
  resolvedAt       DateTime?             @map("resolved_at")
  closedAt         DateTime?             @map("closed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  broker           Broker                @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  alerts           MonitoringAlert[]
  events           MonitoringCaseEvent[]
  evidence         MonitoringEvidence[]

  @@unique([brokerId, referenceNumber])
  @@index([brokerId, category, status, dueAt])
  @@map("monitoring_cases")
}

model MonitoringAlert {
  id                  String          @id
  brokerId            String          @map("broker_id")
  category            String
  ruleCode            String          @map("rule_code")
  ruleVersion         Int             @map("rule_version")
  fingerprint         String
  severity            String
  status              String          @default("open")
