  brokerId       String    @map("broker_id")
  businessDate   DateTime  @map("business_date") @db.Date
  status         String    @default("open")
  cutoffAt       DateTime? @map("cutoff_at")
  closeEvidence  String?   @map("close_evidence")
  closedBy       String?   @map("closed_by")
  closedAt       DateTime? @map("closed_at")
  reopenReason   String?   @map("reopen_reason")
  reopenedBy     String?   @map("reopened_by")
  reopenedAt     DateTime? @map("reopened_at")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  broker         Broker    @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  closedByUser   User?     @relation("BusinessDayCloser", fields: [closedBy], references: [id], onDelete: SetNull)
  reopenedByUser User?     @relation("BusinessDayReopener", fields: [reopenedBy], references: [id], onDelete: SetNull)

  @@unique([brokerId, businessDate])
  @@index([brokerId, status, businessDate])
  @@map("business_day_controls")
}

