DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional fixed code for controlled demonstrations. It must be exactly six
# digits. Leave empty in real environments and remove once an OTP provider is
# connected. Local development defaults to 246810 when this is empty.
FRANK_DEMO_OTP_CODE=""

# ESX normalized market-data gateway. Set MARKET_DATA_PROVIDER="demo" to use
# the visibly labelled simulated feed in a controlled production demo. Use
# "unavailable" to disable the fallback. A configured ESX gateway is used when
# the provider is "auto".
ESX_MARKET_DATA_URL=""
ESX_MARKET_DATA_TOKEN=""
MARKET_DATA_PROVIDER="auto"
MARKET_DATA_STALE_AFTER_MS="90000"
