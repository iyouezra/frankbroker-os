DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Use a direct (non-pooled) branch connection for Prisma migrations. Prisma
# falls back to DATABASE_URL when this is omitted, which keeps local Postgres
# setups simple.
MIGRATION_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Safe default: fictional identities, demo selectors, and visible OTP 246810.
FRANK_DEPLOYMENT_MODE="demo"
FRANK_INVESTOR_AUTH_MODE="demo"
FRANK_DEMO_OTP_CODE=""

# To exercise real investor authentication, set both modes below, generate two
# independent secrets of at least 32 random bytes, and configure an HTTPS OTP
# delivery adapter. Never reuse either secret as a Fayda private key.
# FRANK_DEPLOYMENT_MODE="production"
# FRANK_INVESTOR_AUTH_MODE="otp"
FRANK_SESSION_SECRET=""
FRANK_OTP_HASH_SECRET=""
FRANK_OTP_DELIVERY_URL=""
FRANK_OTP_DELIVERY_TOKEN=""
FRANK_TRUSTED_ORIGINS=""
# Passkeys are scoped to this stable domain. List every exact HTTPS origin that
# may register or use credentials (for example production and staging).
FRANK_WEBAUTHN_RP_ID=""
FRANK_WEBAUTHN_ORIGINS=""
FRANK_WEBAUTHN_RP_NAME="Frank Money"

# Reserved for the future VeriFayda/eSignet adapter. The callback must validate
# discovery/JWKS metadata, issuer, audience, signature, nonce, expiry and `sub`
# before calling the shared investor identity/session boundary.
FAYDA_ISSUER=""
FAYDA_CLIENT_ID=""
FAYDA_PRIVATE_KEY_BASE64=""
FAYDA_REDIRECT_URI=""

# The visibly labelled simulated market feed is the default. These are future
# integration settings; leave them empty for the demo.
ESX_MARKET_DATA_URL=""
ESX_MARKET_DATA_TOKEN=""
MARKET_DATA_STALE_AFTER_MS="90000"
