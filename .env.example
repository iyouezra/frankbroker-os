DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Frank is currently an unauthenticated demo/test product. Every deployment
# enables the fictional role, tenant, and investor switchers. OTP defaults to
# 246810; set this only if the team wants a different six-digit demo code.
FRANK_DEMO_OTP_CODE=""

# The visibly labelled simulated market feed is the default. These are future
# integration settings; leave them empty for the demo.
ESX_MARKET_DATA_URL=""
ESX_MARKET_DATA_TOKEN=""
MARKET_DATA_STALE_AFTER_MS="90000"
