DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional fixed code for controlled demonstrations. It must be exactly six
# digits. Leave empty in real environments and remove once an OTP provider is
# connected. Local development defaults to 246810 when this is empty.
FRANK_DEMO_OTP_CODE=""

# ESX normalized market-data gateway. When omitted, local development uses a
# visibly labelled mock provider; production returns an unavailable feed.
ESX_MARKET_DATA_URL=""
ESX_MARKET_DATA_TOKEN=""
MARKET_DATA_PROVIDER="auto"
MARKET_DATA_STALE_AFTER_MS="90000"
